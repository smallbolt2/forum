// Prisma schema 入口文件（schema folder 模式）。
// 这里仅放 datasource / generator；模型定义在同目录的其它 `*.prisma` 文件中。

datasource db {
  provider = "sqlserver"
  relationMode = "prisma"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}